# praxis_site: the marketing site (jbspraxis.com, preview at next.jbspraxis.com).
# No database: everything it reads or writes goes through the private Site API on HQ (docs/SITE_API.md).
APP_NAME="JBS Praxis"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jbspraxis.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# No database connection is configured or used.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=jbspraxis_site_session
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The site never sends email itself: HQ sends every email.
MAIL_MAILER=log

# Site API on HQ (docs/SITE_API.md, section 6 overrides sections 1-5).
# Must start with https:// when APP_ENV=production: otherwise the site sends nothing to HQ and logs an error.
# Locally: SITE_API_BASE=http://127.0.0.1:8001/api/site/v1 with SITE_API_HOST=hq.localhost
SITE_API_BASE=https://hq.jbspraxis.com/api/site/v1
SITE_API_HOST=
SITE_API_KEY_ID=
SITE_API_SECRET=

# true only on a preview host: noindex on every response and robots.txt disallows everything.
SITE_NOINDEX=false

# Google Analytics 4: loaded only after the visitor accepts the cookie banner. Empty = no banner, no analytics.
GA4_ID=G-91FM19NGCK
# Shown in the calm "HQ is unavailable" message until the settings have been read once.
SITE_FALLBACK_EMAIL=info@jbspraxis.com

# Proxies whose X-Forwarded-* headers are trusted (README, "Visitor IP"). NEVER "*": it would let anyone
# choose the IP that HQ's limits count, and the site ignores it.
#   Not behind a proxy (the default): leave it empty.
#   Behind Cloudflare: TRUSTED_PROXIES=cloudflare (Cloudflare's published ranges, kept in config/site.php),
#   and allow only Cloudflare's ranges to reach the origin in the firewall.
#   Another proxy: list its addresses or ranges, e.g. TRUSTED_PROXIES=10.0.0.5,10.0.1.0/24
# CF-Connecting-IP and CF-IPCountry are believed only when the connecting address is a Cloudflare one.
TRUSTED_PROXIES=

# Cloudflare Turnstile on every form. Off while either key is empty (the default). When both are set, the
# widget shows on every form and each token is checked with Cloudflare before anything is sent to HQ.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
