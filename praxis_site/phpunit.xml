<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SITE_API_BASE" value="http://hq.test/api/site/v1" force="true"/>
        <env name="SITE_API_HOST" value="" force="true"/>
        <env name="SITE_API_KEY_ID" value="site-test" force="true"/>
        <env name="SITE_API_SECRET" value="test-secret" force="true"/>
        <env name="SITE_NOINDEX" value="true" force="true"/>
        <env name="SITE_FALLBACK_EMAIL" value="fallback@jbspraxis.com" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="TURNSTILE_SITE_KEY" value="" force="true"/>
        <env name="TURNSTILE_SECRET_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
