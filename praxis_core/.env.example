APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Hosts: the public site, HQ (staff) and the client portal. Keep SESSION_DOMAIN unset
# so each host has its own login cookie.
SITE_DOMAIN=jbspraxis.com
HQ_DOMAIN=hq.jbspraxis.com
PORTAL_DOMAIN=portal.jbspraxis.com

# Passkeys (docs/SIGN_IN.md) belong to HQ's and the portal's own hosts on https. Only for a local copy:
# WEBAUTHN_ORIGIN_HQ=http://hq.localhost:8000
# WEBAUTHN_ORIGIN_PORTAL=http://portal.localhost:8000

# Private site API (docs/SITE_API.md): the marketing site signs every request with this key.
# Same id and secret in praxis_site's .env. Generate the secret with: php -r "echo bin2hex(random_bytes(32));"
# During a rotation, keep the old pair in SITE_API_KEY_ID_PREVIOUS / SITE_API_SECRET_PREVIOUS.
SITE_API_KEY_ID=
SITE_API_SECRET=

# Careers retention (config/praxis.php): true runs careers:purge-cvs every night, deleting CVs and anonymising
# applications 12 months after they arrive, as the privacy policy says. Try "php artisan careers:purge-cvs --dry-run" first.
CV_RETENTION_PURGE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="JBS Praxis"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
